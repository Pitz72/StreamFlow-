{
  "name": "streamflow",
  "private": true,
  "version": "0.10.2",
  "streamflowEdition": "Solid Snake",
  "description": "Desktop Audio Streaming Client",
  "author": {
    "name": "Runtime StreamFlow",
    "email": "info@runtimeradio.it"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:dev": "npm run build:main && concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development ELECTRON_DISABLE_SECURITY_WARNINGS=true electron .\"",
    "electron:build": "npm test && npm run build && npm run build:main && electron-builder --publish never",
    "icons": "node scripts/generate-icons.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.runtimeradio.streamflow",
    "productName": "Runtime StreamFlow",
    "directories": {
      "output": "builds/${version}",
      "buildResources": "build"
    },
    "artifactName": "Runtime-StreamFlow-${version}-${arch}.${ext}",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/preload/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pitz72",
        "repo": "StreamFlow-",
        "releaseType": "release"
      }
    ]
  }
}
